# PitchVision AI Frontend Environment Configuration
# Copy to .env.local for local overrides, or set in Vercel Project Settings -> Environment Variables.

# Backend API base URL (e.g. https://pitchvision-ai-backend.onrender.com/api)
VITE_API_URL=http://localhost:8000/api

# Optional: Backend server origin for /uploads video streams.
# Automatically derived from VITE_API_URL if omitted.
# VITE_SERVER_URL=http://localhost:8000
