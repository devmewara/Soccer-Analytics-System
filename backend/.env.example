# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# CORS Configuration (comma-separated origins, no trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Optional regex for preview deployments (e.g., https://.*\.vercel\.app)
CORS_ORIGIN_REGEX=

# Computer Vision Model Weights Path
YOLO_MODEL_PATH=yolo11n.pt
# Inference resolution (default 1280 for optimal small ball/player detection on broadcast 1080p/4K)
YOLO_IMGSZ=1280
# Inference device: 'auto' (detects Apple Silicon MPS, NVIDIA CUDA, or CPU fallback), or force 'cpu', 'cuda', 'mps'
YOLO_DEVICE=auto

# Video Upload Directory (relative to backend/ or absolute path for mounted persistent disk)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=500
